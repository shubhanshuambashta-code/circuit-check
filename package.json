{
  "name": "circuitcheck",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:branch-pages": "tsc -b && vite build --mode pages --base=/circuit-check/site/ --outDir site",
    "test:checks": "node --test tests/test_tscircuit_checks.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@tscircuit/checks": "0.0.279",
    "@tscircuit/solver-utils": "0.0.25",
    "circuit-json": "0.0.550",
    "lucide-react": "0.552.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "description": "Local KiCad PCB review with native checks, evidence and verified track-width repair previews.",
  "license": "MIT"
}
